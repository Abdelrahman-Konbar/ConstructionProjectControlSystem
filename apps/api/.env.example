DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construction_control?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/construction_control?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
PORT=5000
FRONTEND_URL="http://localhost:8443"
ENABLE_SWAGGER=true
NODE_ENV=development

# Binary documents are stored outside PostgreSQL. Local storage is the safe
# development adapter. Production must explicitly select a provider and, when
# using a persistent local volume, opt in with ALLOW_LOCAL_DOCUMENT_STORAGE.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_DIR="./storage/documents"
ALLOW_LOCAL_DOCUMENT_STORAGE=false

# Invitations always persist securely. Configure an email provider separately
# before enabling external delivery; the application never claims an email was
# sent when no provider is configured.
# INVITATION_EMAIL_PROVIDER=
